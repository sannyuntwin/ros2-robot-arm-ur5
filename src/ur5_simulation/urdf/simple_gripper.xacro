<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="simple_gripper" params="prefix parent">

    <!-- Palm plate fixed to tool0 -->
    <link name="${prefix}gripper_base">
      <visual>
        <origin xyz="0 0 0.01" rpy="0 0 0"/>
        <geometry><box size="0.06 0.06 0.02"/></geometry>
        <material name="gripper_gray"><color rgba="0.5 0.5 0.5 1"/></material>
      </visual>
      <inertial>
        <mass value="0.3"/>
        <origin xyz="0 0 0.01"/>
        <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
      </inertial>
    </link>

    <joint name="${prefix}gripper_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}gripper_base"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Left finger — slides in +Y direction -->
    <link name="${prefix}left_finger">
      <visual>
        <origin xyz="0 0.006 -0.02" rpy="0 0 0"/>
        <geometry><box size="0.012 0.012 0.04"/></geometry>
        <material name="gripper_dark"><color rgba="0.2 0.2 0.2 1"/></material>
      </visual>
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 0.006 -0.02"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>

    <joint name="${prefix}left_finger_joint" type="prismatic">
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}left_finger"/>
      <origin xyz="0 0.015 0.02" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="0.04" effort="50.0" velocity="0.5"/>
    </joint>

    <!-- Right finger — mirrors left via mimic constraint -->
    <link name="${prefix}right_finger">
      <visual>
        <origin xyz="0 -0.006 -0.02" rpy="0 0 0"/>
        <geometry><box size="0.012 0.012 0.04"/></geometry>
        <material name="gripper_dark"><color rgba="0.2 0.2 0.2 1"/></material>
      </visual>
      <inertial>
        <mass value="0.05"/>
        <origin xyz="0 -0.006 -0.02"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>

    <joint name="${prefix}right_finger_joint" type="prismatic">
      <parent link="${prefix}gripper_base"/>
      <child link="${prefix}right_finger"/>
      <origin xyz="0 -0.015 0.02" rpy="0 0 0"/>
      <axis xyz="0 -1 0"/>
      <limit lower="0.0" upper="0.04" effort="50.0" velocity="0.5"/>
    </joint>

    <!-- ros2_control interface — both fingers commanded directly (no mimic support in Gazebo Harmonic) -->
    <ros2_control name="${prefix}GripperSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <joint name="${prefix}left_finger_joint">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">0.04</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}right_finger_joint">
        <command_interface name="position">
          <param name="min">0</param>
          <param name="max">0.04</param>
        </command_interface>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </ros2_control>

  </xacro:macro>
</robot>
